# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Which model provider answers -----------------------------------------
# google | anthropic | openai | groq | ollama
# The assignment prefers Gemini, so `google` is the default.
INSIGHT_LLM_PROVIDER=google

# Supply the key for whichever provider you selected above.
# google    -> free key, no billing account: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# anthropic -> https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# groq      -> free key, no payment details: https://console.groq.com/keys
GROQ_API_KEY=
# openai    -> https://platform.openai.com/api-keys
OPENAI_API_KEY=
# ollama    -> no key; run `ollama serve` locally

# --- BigQuery --------------------------------------------------------------
# Your own GCP project id.  The dataset is public; this project is only the
# one queries are attributed to.  BigQuery *sandbox* is enough and needs no
# credit card and no billing account.  Do not start a "free trial".
GOOGLE_CLOUD_PROJECT=

# --- Optional overrides ----------------------------------------------------
# Leave these unset to use the provider's own defaults.
# INSIGHT_MODEL_PRIMARY_OVERRIDE=
# INSIGHT_MODEL_FAST_OVERRIDE=
# INSIGHT_EXECUTOR=bigquery            # bigquery | recorded (offline fixtures)
# INSIGHT_BQ_MAX_BYTES_BILLED=2000000000
# INSIGHT_MAX_SQL_REPAIR_ATTEMPTS=2
# INSIGHT_LOG_LEVEL=INFO
# INSIGHT_PSEUDONYM_KEY=               # HMAC key for customer pseudonyms
