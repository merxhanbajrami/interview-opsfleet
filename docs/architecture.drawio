        <mxCell id="n29" parent="g25" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fontColor=#666666;" value="Generated SQL is untrusted input. It is checked by parsing it, not by asking the model to behave.&lt;br&gt;An unclassified column is unreachable, because the guard is an allowlist — a column added upstream cannot leak before it is classified." vertex="1">
